# Slack App credentials (from api.slack.com/apps → Basic Information)
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_SIGNING_SECRET=your-signing-secret

# Your Vercel deployment URL (no trailing slash)
APP_URL=https://your-app.vercel.app

# Upstash Redis (free tier at upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Digest mode: "realtime" or "daily"
DIGEST_MODE=daily

# Random secret for triggering the digest manually (openssl rand -hex 32)
CRON_SECRET=your-random-secret
